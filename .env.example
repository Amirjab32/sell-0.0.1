# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Storefront Sync & Server Secrets (NEVER expose with VITE_ prefix)
# ------------------------------------------------------------------

# Shared secret required by POST /api/sync/import-from-source
# Send via `Authorization: Bearer <token>` or `X-Admin-Sync-Token: <token>`
ADMIN_SYNC_TOKEN="CHANGE_ME_STRONG_RANDOM_SECRET"

# URL of Site 1 (Internal Pricing System) catalog JSON endpoint
SOURCE_CATALOG_URL="https://pricing.example.com/api/public-sync/catalog"

# Optional secret sent by Site 2 to Site 1 in X-Sync-Secret & Authorization: Bearer
SOURCE_CATALOG_TOKEN="CHANGE_ME_SOURCE_TOKEN"

# Optional local SQLite file path for development (defaults to .data/local.db)
LOCAL_SQLITE_PATH=".data/local.db"

# Environment mode: development | production
APP_ENV="development"
